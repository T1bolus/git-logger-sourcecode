LOG_LEVEL=INFO
LOG_FILE=logs/git-logger.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DATA_DIR=data
HOST=0.0.0.0
PORT=8814

# Default check interval in seconds (e.g. 3600 = 1h, 300 = 5min)
DEFAULT_INTERVAL=3600

# Git configuration for automatic commits
GIT_USER=Git Logger
GIT_EMAIL=logger@example.com

# GitHub push (optional - leave empty to skip pushing)
GITHUB_TOKEN=
GITHUB_REPO=

# Steam login (optional - required for steamcommunity.com / steampowered.com URLs)
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_COOKIE_FILE=data/steamcookies.pkl
STEAM_TOKEN_FILE=data/steam_tokens.json
